# Hermes environment — Pro Lash
# Copy to `.env` (git-ignored) and fill in real values only once each is actually provisioned.
# NEVER commit the real .env. NEVER hardcode these in the Dockerfile or compose file.

# pro-lash-engagement — scoped to Instagram/TikTok DM+comment access only.
# STATUS: not provisioned. Instagram/TikTok gate this behind Business API approval —
# there is no self-serve key to generate yet (see agents/README.md).
INSTAGRAM_TOKEN=

# pro-lash-content — no live posting tool connected; this agent is pure draft, no key needed.
# (left here for when a scheduler like Buffer/Later is eventually connected)
CONTENT_SCHEDULER_TOKEN=

# Dashboard revenue card — Shopify read-only Admin API token.
# STATUS: not provisioned. Store is live at prolashserum.myshopify.com; the token
# was not generated yet (Settings → Apps and sales channels → Develop apps).
SHOPIFY_ADMIN_TOKEN=

# Where escalations actually land for a human to see. STATUS: not decided/connected yet —
# no Slack or email API is wired in. Until this is set, escalations only exist in
# ops/audit.log — a human must check the log, nothing pushes to them proactively.
ESCALATION_CHANNEL_WEBHOOK=
